# Local default. On Vercel set this to the public Dropmai_Backend URL (never localhost).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ROOT_DOMAIN=dropmai.com.br

# Google OAuth is configured only on the Backend:
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REDIRECT_URI, FRONTEND_URL, SESSION_SECRET
# Frontend links to {NEXT_PUBLIC_API_URL}/api/v1/auth/google and receives the
# signed session via /auth/callback?session=dm1....
